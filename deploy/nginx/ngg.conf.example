# NGG public reverse proxy — manual reference (generated by deploy-vps.sh --public).
#
# Copy this file to /etc/nginx/sites-available/ngg.conf (+ symlink into
# sites-enabled/) on Debian/Ubuntu, or /etc/nginx/conf.d/ngg.conf on
# RHEL/Fedora/openSUSE/Arch. Replace <16-HEX-GATE> with the random suffix
# from /etc/ngg/web-gate.txt and <PUBLIC_PORT> with --web-port (default 8080).
#
# IMPORTANT: do NOT add auth_basic here. Browsers would replace the Web UI's
# "Authorization: Bearer <token>" header with Basic credentials and nginx
# would return 401 before the request reaches NGG. Security is provided by:
#   1) a 16-character random secret path + cookie gate,
#   2) NGG's own Bearer Token on every /api/ request,
#   3) TLS after --domain + --with-tls.
#
# The control API itself still binds to 127.0.0.1:9090; never publish 9090.

map $cookie_ngg_gate $ngg_gate_ok {
    default 0;
    "<16-HEX-GATE>" 1;
}

server {
    listen 0.0.0.0:<PUBLIC_PORT>;
    server_name _;                      # or your domain when --domain is used

    client_max_body_size 32m;

    # Let's Encrypt HTTP-01 challenge (certbot certonly --webroot).
    location /.well-known/acme-challenge/ { root /var/www/html; }

    # Open this ONCE in the browser: it sets the gate cookie and redirects to /.
    location = /<16-HEX-GATE> {
        add_header Set-Cookie "ngg_gate=<16-HEX-GATE>; Path=/; HttpOnly; SameSite=Strict; Max-Age=31536000" always;
        return 302 /;
    }

    location / {
        if ($ngg_gate_ok = 0) { return 404; }
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket (/api/v1/ws) needs Upgrade headers.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# After: certbot certonly --webroot -w /var/www/html -d <DOMAIN>
# append a second server block with the same locations:
#
# server {
#     listen 443 ssl;
#     server_name <DOMAIN>;
#     ssl_certificate     /etc/letsencrypt/live/<DOMAIN>/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/<DOMAIN>/privkey.pem;
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ... same locations as above ...
# }
