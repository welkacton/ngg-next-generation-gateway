# NGG systemd unit — manual installation reference.
# Copy to /etc/systemd/system/ngg.service and adjust the four absolute paths.
# The same unit is generated automatically by scripts/deploy-vps.sh install.
[Unit]
Description=NGG Next-Generation Gateway
Documentation=https://github.com/welkacton/ngg-next-generation-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ngg
Group=ngg
WorkingDirectory=/opt/ngg
Environment=NGG_PORT=9090
ExecStart=/opt/ngg/nggd -config /etc/ngg/ngg.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
# Required for Stage 2 unified TUN / low-port binding. Remove both capability
# lines and set NoNewPrivileges=true when TUN is not used.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=false
# Only config, state and log directories remain writable.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/ngg /var/lib/ngg /var/log/ngg
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
